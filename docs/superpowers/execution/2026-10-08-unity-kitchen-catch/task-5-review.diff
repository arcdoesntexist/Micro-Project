+using UnityEngine;
+using UnityEngine.UI;
+
+namespace CPS.KitchenCatch
+{
+    public sealed class PrototypeMenu : MonoBehaviour
+    {
+        [SerializeField] private GameSessionController gameplayTemplate;
+        [SerializeField] private SceneNavigator navigator;
+        [SerializeField] private Text status;
+        [SerializeField] private Button startButton;
+        public string ValidationError => gameplayTemplate == null ? "Gameplay template is missing." :
+            gameplayTemplate.GetValidationError(AppSession.Instance);
+        public void SelectDemo(DifficultyId difficulty)
+        {
+            var app = AppSession.Instance;
+            if (app == null || app.Store == null) return;
+            var selected = app.SelectedProfile;
+            if (selected == null)
+                selected = app.Store.Profiles.Count > 0 ? app.Store.Profiles[0] : app.Store.Create("Demo Player");
+            app.Select(selected.PlayerId, difficulty);
+        }
+        public void SelectEasy() => SelectDemo(DifficultyId.Easy);
+        public void SelectNormal() => SelectDemo(DifficultyId.Normal);
+        public void SelectHard() => SelectDemo(DifficultyId.Hard);
+        public bool StartSelectedGame() => ValidationError == null && navigator != null && navigator.GoTo("Gameplay");
+        public void StartGame() => StartSelectedGame();
+        private void Update()
+        {
+            string error = ValidationError;
+            if (startButton != null) startButton.interactable = error == null && navigator != null && !navigator.IsTransitioning;
+            if (status != null)
+            {
+                var app = AppSession.Instance;
+                status.text = error ?? (app.SelectedProfile.DisplayName + " / " + app.SelectedDifficulty);
+                if (app != null && !string.IsNullOrEmpty(app.Store.Warning)) status.text += "\n" + app.Store.Warning;
+            }
+        }
+    }
+}
