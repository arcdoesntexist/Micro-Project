+using UnityEngine;
+using UnityEngine.UI;
+
+namespace CPS.KitchenCatch
+{
+    public sealed class PrototypeGameplayUI : MonoBehaviour
+    {
+        [SerializeField] private GameSessionController controller;
+        [SerializeField] private Text hud;
+        [SerializeField] private Text status;
+        [SerializeField] private GameObject pauseButton;
+        [SerializeField] private GameObject resumeButton;
+        [SerializeField] private GameObject restartButton;
+        [SerializeField] private GameObject menuButton;
+        private void Update()
+        {
+            if (controller == null) return;
+            var model = controller.Model;
+            hud.text = $"HP {model.Health.CurrentHp}    Time {model.RemainingSeconds:0.0} s    Score {model.Score.Score}    Rank {model.Score.CurrentRank}";
+            bool results = controller.State == SessionState.Results;
+            pauseButton.SetActive(controller.State == SessionState.Playing && !controller.IsPaused);
+            resumeButton.SetActive(controller.IsPaused);
+            restartButton.SetActive(results);
+            menuButton.SetActive(results || controller.ValidationError != null);
+            if (controller.ValidationError != null) status.text = controller.ValidationError;
+            else if (controller.IsPaused) status.text = "Paused - choose Resume";
+            else if (controller.CountdownSeconds > 0) status.text = Mathf.CeilToInt(controller.CountdownSeconds).ToString();
+            else if (results)
+            {
+                var result = controller.LastResult;
+                status.text = $"{result.DisplayName}: {result.EndReason}\nScore {result.Score} / {result.Difficulty} / {result.PlayedSeconds:0.0} s\nFood caught {result.FoodCaught}, missed {result.FoodMissed}, trash {result.TrashEaten}\nSimulated Input - Keyboard\nForce: Sensor not connected";
+            }
+            else if (controller.State == SessionState.Triumph) status.text = "Triumph!";
+            else if (controller.State == SessionState.Dying) status.text = "HP depleted";
+            else status.text = "A / Left Arrow     D / Right Arrow\nSimulated Input - Keyboard";
+        }
+    }
+}
